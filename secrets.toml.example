# Paste into Streamlit Cloud → your app → Settings → Secrets. Every line is optional.
# Format: NAME = "value", straight double quotes, one setting per line.

# Password for the dashboard (recommended if the link is shared)
DASHBOARD_PASSWORD = "choose-a-password"

# Live LLM explanations (otherwise the notebook's built-in template text is used)
# OPENAI_API_KEY = "sk-..."
# OPENROUTER_API_KEY = "..."

# Names shown in Step 1 (defaults below)
# DISPATCHER_NAME = "Ariyan"
# SUPERVISOR_NAME = "Terri-Ann"
# OFFICER_NAME = "Grant"
# DRIVER_NAME = "Habib"
# TEAM_TRAINING_DATE = "2026-11-16"

# "1" = the supervisor approves every action; "0" (default) = only high-impact actions, as in the notebook
# REQUIRE_SUPERVISOR_APPROVAL = "0"

# Review deadlines: 1.0 = real 5 / 10 / 20 minutes; 0.5 = half as long
# DEMO_DEADLINE_SCALE = "1.0"

# Street map with CARTO tiles (otherwise OpenStreetMap)
# CARTO_API_KEY = "..."

# Optional: also text the driver alerts (Twilio)
# TWILIO_ACCOUNT_SID = "AC..."
# TWILIO_AUTH_TOKEN = "..."
# TWILIO_FROM_NUMBER = "+1..."
# DRIVER_PHONE_NUMBER = "+1..."
